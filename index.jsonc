{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "cars-deployment",

  // 1-2 sentence summary about this repo.
  "summary": "What runs on the Azure resources of the cars application: the container apps of its masters and clients. Empty after the cluster was removed; a Bicep container-app template, its parameter files and deploy.js follow.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure Container Apps of the masters and clients, per side and stage",
    "Bicep template container-app, parameter files <side>-<service>-<stage>.bicepparam (to come)"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "cars-infra": "Container Apps environments and container registry the apps run in and pull from"
    },

    // "<repo-b>": "why / API"
    "usedBy": {}
  }
}
