{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "cars-deployment",

  // 1-2 sentence summary about this repo.
  "summary": "What runs in the Kubernetes cluster of the cars application: manifests, Helm charts with their value files and image tags, and the ArgoCD applications that sync them.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Kubernetes workloads cars-ui, cars-bff and cars-master in namespace demo",
    "Helm charts, value files values.yaml → demo-values.yaml → image-tag.yaml",
    "ArgoCD app of apps, auto-sync from git"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "cars-infra": "AKS cluster and container registry the workloads run on and pull from"
    },

    // "<repo-b>": "why / API"
    "usedBy": {}
  }
}
